      "updated": 1785004570509,
      "link": null,
      "locked": false,
      "text": "📂 Projects (+ Events)\nOverview — all projects, filterable by status/department/intern-extern\nProject detail — idea/description, document, requirements, members, sponsors, owners, status, progress %\nCreate project — global or per-department, intern or extern, sponsor + member-limit rules enforced at\ncreation\nApproval pipeline — status stages leading to approved, then moved to the next board\nEvents — the piece we noted as \"forgotten,\" ties into projects (relationship still open)\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "📂 Projects (+ Events)\nOverview — all projects, filterable by status/department/intern-extern\nProject detail — idea/description, document, requirements, members, sponsors, owners, status, progress %\nCreate project — global or per-department, intern or extern, sponsor + member-limit rules enforced at creation\nApproval pipeline — status stages leading to approved, then moved to the next board\nEvents — the piece we noted as \"forgotten,\" ties into projects (relationship still open)\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
