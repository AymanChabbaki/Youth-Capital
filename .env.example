DATABASE_URL="postgresql://user:password@localhost:5432/youth_capital?schema=public"
PORT=5173
BASE_PATH="/"
NODE_ENV="development"
# Comma-separated list of frontend origins allowed to make credentialed requests.
# Required in production — without it, cross-origin requests are rejected by default.
ALLOWED_ORIGINS="https://your-frontend.vercel.app"
GROQ_API_KEY=""

# Outbound email (admin bulk-send + automatic application approve/reject
# notifications). Spaceship Email's documented outgoing server is
# mail.spacemail.com, port 465 or 587 with SSL — confirm in your Spaceship
# email control panel if you're on a different provider.
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Youth Capital"
SMTP_FROM_EMAIL=""

# Public URLs. FRONTEND_URL is where users land after Google/LinkedIn sign-in
# and what password-reset emails link to (defaults to the first ALLOWED_ORIGINS
# entry). PUBLIC_API_URL builds the OAuth redirect URIs and must match what is
# registered with each provider exactly.
FRONTEND_URL="https://www.youthcapital.org"
PUBLIC_API_URL="https://youth-capital-backend.vercel.app"

# "Continue with Google" — Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID (Web application). Authorized redirect URI:
#   ${PUBLIC_API_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# "Continue with LinkedIn" — LinkedIn Developers → your app → Products: add
# "Sign In with LinkedIn using OpenID Connect". Auth tab → redirect URL:
#   ${PUBLIC_API_URL}/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
