DATABASE_URL="postgresql://user:password@localhost:5432/youth_capital?schema=public"
PORT=5173
BASE_PATH="/"
NODE_ENV="development"
# Comma-separated list of frontend origins allowed to make credentialed requests.
# Required in production — without it, cross-origin requests are rejected by default.
ALLOWED_ORIGINS="https://your-frontend.vercel.app"
GROQ_API_KEY=""

# Outbound email (admin bulk-send + automatic application approve/reject
# notifications). Spaceship Email's documented outgoing server is
# mail.spacemail.com, port 465 or 587 with SSL — confirm in your Spaceship
# email control panel if you're on a different provider.
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Youth Capital"
SMTP_FROM_EMAIL=""
