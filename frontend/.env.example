# ── Youth Capital — frontend local environment ──────────────────────────────
# SECURITY RULE: every VITE_* variable is BUNDLED INTO PUBLIC JAVASCRIPT.
# Never put API secrets, database URLs, or signing keys behind a VITE_ prefix.
# Server-only secrets (GROQ_API_KEY, DATABASE_URL, JWT_SECRET, Cloudinary
# API key/secret) belong in the BACKEND environment, never here.

# Backend API endpoint for local dev
VITE_API_URL=http://localhost:3000

# Cloudinary — unsigned uploads only (article thumbnails + profile avatars).
# These two are SAFE to expose. Paste the same values you have in Vercel:
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional community links
# VITE_COMMUNITY_LINK=https://chat.whatsapp.com/...
# VITE_DISCORD_LINK=https://discord.gg/...
