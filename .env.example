DATABASE_URL="postgresql://user:password@localhost:5432/youth_capital?schema=public"
PORT=5173
BASE_PATH="/"
NODE_ENV="development"
# Comma-separated list of frontend origins allowed to make credentialed requests.
# Required in production — without it, cross-origin requests are rejected by default.
ALLOWED_ORIGINS="https://your-frontend.vercel.app"
GROQ_API_KEY=""

# Outbound email (admin bulk-send + automatic application approve/reject
# notifications). For Spaceship-hosted email (Titan-powered), typical values
# are smtp.titan.email / 465 / true — confirm the exact ones in your
# Spaceship email control panel, since providers vary.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Youth Capital"
SMTP_FROM_EMAIL=""
